+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Generic kernel API compatibility for building this driver out of tree on
+ * newer kernels; force-included by the Makefile.
+ */
+#ifndef __SKW_KCOMPAT_H__
+#define __SKW_KCOMPAT_H__
+
+#include <linux/version.h>
+#include <linux/timer.h>
+#include <linux/sched/clock.h>
+
+/* del_timer*() were renamed to timer_delete*() (6.2) and dropped (6.15) */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+#define del_timer(t)		timer_delete(t)
+#define del_timer_sync(t)	timer_delete_sync(t)
+/* platform_driver.remove returns void since 6.11 */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+#define SKW_PLAT_REMOVE_T	void
+#define SKW_PLAT_REMOVE_RET
+#else
+#define SKW_PLAT_REMOVE_T	int
+#define SKW_PLAT_REMOVE_RET	0
+#endif
+
+#endif
+
+#endif
