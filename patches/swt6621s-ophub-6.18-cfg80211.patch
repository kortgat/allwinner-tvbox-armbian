diff --git a/src/swt6621s_wifi/Makefile b/src/swt6621s_wifi/Makefile
index c745fb1..9e72d0f 100755
--- a/src/swt6621s_wifi/Makefile
+++ b/src/swt6621s_wifi/Makefile
@@ -7,6 +7,17 @@ ccflags-y += -include $(src)/../swt6621s-config.h
 ccflags-y += -I$(src)/../include
 ccflags-y += -I$(src)/../include/linux/platform_data
 
+# Newer cfg80211 (backported into some 6.18 vendor kernels): key/station ops
+# take a wireless_dev and the core assigns remain_on_channel/mgmt_tx cookies.
+ifneq ($(shell grep -s "u64 cookie, const u8 \*rx_addr" $(srctree)/include/net/cfg80211.h),)
+ccflags-y += -DSKW_CFG80211_WDEV_API
+endif
+# Newer ieee80211_mgmt layout: action_code moved into u.action and the
+# per-action union became anonymous.
+ifneq ($(shell grep -s "define IEEE80211_MIN_ACTION_SIZE(type)" $(srctree)/include/linux/ieee80211.h),)
+ccflags-y += -DSKW_IEEE80211_ACTION_V2
+endif
+
 obj-m += swt6621s_wifi.o
 swt6621s_wifi-objs += skw_core.o
 swt6621s_wifi-objs += skw_core_dbg.o
