+/* Pattern windows spread over the whole size also catch address aliasing */
+static bool athena_memtest(unsigned long size)
+{
+	unsigned long step = size / 64, off;
+	int pass, i;
+
+	for (pass = 0; pass < 2; pass++) {
+		u32 x = pass ? 0xa5a5a5a5 : 0x5a5a5a5a;
+
+		for (off = 0; off < size; off += step) {
+			u32 *p = (u32 *)(CFG_SYS_SDRAM_BASE + off);
+
+			for (i = 0; i < 256; i++)
+				p[i] = (u32)(off + i * 4) ^ x;
+		}
+		for (off = 0; off < size; off += step) {
+			u32 *p = (u32 *)(CFG_SYS_SDRAM_BASE + off);
+
+			for (i = 0; i < 256; i++)
+				if (p[i] != ((u32)(off + i * 4) ^ x))
+					return false;
+		}
+	}
+	return true;
+}
